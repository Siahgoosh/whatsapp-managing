# Application
NODE_ENV=production
PORT=9454
APP_NAME=WhatsApp Campaign Manager
APP_URL=http://localhost:9454
TZ=Asia/Tehran

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_9454!
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=wcm.sid
SESSION_MAX_AGE_HOURS=24

# Security
CORS_ORIGIN=http://localhost:9454
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=8
MAX_UPLOAD_MB=16

# Campaign safety (cannot go below MIN_DELAY_SECONDS)
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=30
DEFAULT_DELAY_SECONDS=5
MAX_RETRY_ATTEMPTS=1
RETRY_WAIT_SECONDS=12
MAX_CONSECUTIVE_FAILURES=5

# Optional OpenAI-compatible AI assistant
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
