{
  "name": "whatsapp-campaign-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Professional panel for consented WhatsApp group campaign management",
  "type": "module",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "NODE_ENV=development node --watch backend/src/index.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "node --test --test-timeout=20000 backend/tests/*.test.js",
    "healthcheck": "node scripts/healthcheck.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jalaali-js": "^1.2.8",
    "multer": "^2.0.1",
    "node-cron": "^4.0.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
